#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp

# Palette lifted straight from the desktop app's Qt stylesheet:
#   background #141414 | gold #f0a500 | text #e0e0e0 | labels #888 | log #0d0d0d

<SectionLabel@Label>:
    size_hint_y: None
    height: dp(16)
    halign: 'left'
    valign: 'bottom'
    color: 0.53, 0.53, 0.53, 1
    font_size: sp(10)
    font_name: 'desqueeze-mono'
    text_size: self.width, None

<Divider@Widget>:
    size_hint_y: None
    height: dp(1)
    canvas:
        Color:
            rgba: 0.165, 0.165, 0.165, 1
        Rectangle:
            pos: self.pos
            size: self.size

<Field@BoxLayout>:
    # the sunken #1e1e1e input box used for paths and numbers
    size_hint_y: None
    height: dp(38)
    canvas.before:
        Color:
            rgba: 0.118, 0.118, 0.118, 1
        Rectangle:
            pos: self.pos
            size: self.size
        Color:
            rgba: 0.18, 0.18, 0.18, 1
        Line:
            width: 1
            rectangle: self.x, self.y, self.width, self.height

<PathLabel@Label>:
    halign: 'left'
    valign: 'middle'
    shorten: True
    shorten_from: 'left'
    font_size: sp(12)
    font_name: 'desqueeze-mono'
    color: 0.88, 0.88, 0.88, 1
    text_size: self.width - dp(16), self.height

<GhostButton@Button>:
    size_hint_x: None
    width: dp(84)
    background_normal: ''
    background_down: ''
    background_color: (0.102, 0.102, 0.102, 1) if self.state == 'normal' else (0.18, 0.18, 0.18, 1)
    color: (0.8, 0.8, 0.8, 1) if not self.disabled else (0.27, 0.27, 0.27, 1)
    font_size: sp(12)
    font_name: 'desqueeze-mono'
    canvas.after:
        Color:
            rgba: 0.2, 0.2, 0.2, 1
        Line:
            width: 1
            rectangle: self.x, self.y, self.width, self.height

<TabButton@ToggleButton>:
    group: 'media'
    allow_no_selection: False
    background_normal: ''
    background_down: ''
    background_color: (0.118, 0.118, 0.118, 1) if self.state == 'normal' else (0.16, 0.13, 0.05, 1)
    color: (0.53, 0.53, 0.53, 1) if self.state == 'normal' else (0.941, 0.647, 0.0, 1)
    font_size: sp(13)
    font_name: 'desqueeze-mono'
    bold: self.state == 'down'
    canvas.after:
        # a gold underline marks the live tab
        Color:
            rgba: (0.941, 0.647, 0.0, 1) if self.state == 'down' else (0.18, 0.18, 0.18, 1)
        Rectangle:
            pos: self.x, self.y
            size: self.width, dp(2) if self.state == 'down' else dp(1)

<RunButton@Button>:
    background_normal: ''
    background_down: ''
    background_color: (0.941, 0.647, 0.0, 1) if not self.disabled else (0.227, 0.227, 0.227, 1)
    color: (0, 0, 0, 1) if not self.disabled else (0.4, 0.4, 0.4, 1)
    bold: True
    font_size: sp(15)
    font_name: 'desqueeze-mono'

<CancelButton@Button>:
    background_normal: ''
    background_down: ''
    background_color: (0.165, 0.102, 0.102, 1) if not self.disabled else (0.118, 0.118, 0.118, 1)
    color: (0.753, 0.251, 0.251, 1) if not self.disabled else (0.27, 0.27, 0.27, 1)
    font_size: sp(12)
    font_name: 'desqueeze-mono'
    canvas.after:
        Color:
            rgba: (0.353, 0.165, 0.165, 1) if not self.disabled else (0.133, 0.133, 0.133, 1)
        Line:
            width: 1
            rectangle: self.x, self.y, self.width, self.height

<NumberInput@TextInput>:
    multiline: False
    write_tab: False
    input_filter: 'float'
    font_size: sp(13)
    font_name: 'desqueeze-mono'
    background_normal: ''
    background_active: ''
    background_color: 0.118, 0.118, 0.118, 1
    foreground_color: 0.88, 0.88, 0.88, 1
    cursor_color: 0.941, 0.647, 0.0, 1
    selection_color: 0.941, 0.647, 0.0, 0.45
    padding: [dp(8), dp(9), dp(8), dp(9)]

<NameInput@NumberInput>:
    input_filter: None

<OptionRow@SpinnerOption>:
    background_normal: ''
    background_down: ''
    background_color: (0.118, 0.118, 0.118, 1) if self.state == 'normal' else (0.941, 0.647, 0.0, 1)
    color: (0.88, 0.88, 0.88, 1) if self.state == 'normal' else (0, 0, 0, 1)
    font_size: sp(12)
    font_name: 'desqueeze-mono'
    halign: 'left'
    valign: 'middle'
    text_size: self.width - dp(20), None
    size_hint_y: None
    height: dp(46)

<DarkSpinner@Spinner>:
    option_cls: 'OptionRow'
    background_normal: ''
    background_down: ''
    background_color: 0.118, 0.118, 0.118, 1
    color: 0.88, 0.88, 0.88, 1
    font_size: sp(12)
    font_name: 'desqueeze-mono'
    halign: 'left'
    valign: 'middle'
    shorten: True
    shorten_from: 'right'
    text_size: self.width - dp(28), None
    canvas.after:
        Color:
            rgba: 0.18, 0.18, 0.18, 1
        Line:
            width: 1
            rectangle: self.x, self.y, self.width, self.height
        Color:
            rgba: 0.53, 0.53, 0.53, 1
        Triangle:
            points:
                [self.right - dp(20), self.center_y + dp(3), \
                self.right - dp(10), self.center_y + dp(3), \
                self.right - dp(15), self.center_y - dp(3)]

<GoldProgress@Widget>:
    value: 0
    size_hint_y: None
    height: dp(6)
    canvas:
        Color:
            rgba: 0.118, 0.118, 0.118, 1
        Rectangle:
            pos: self.pos
            size: self.size
        Color:
            rgba: 0.941, 0.647, 0.0, 1
        Rectangle:
            pos: self.pos
            size: self.width * (max(0, min(100, self.value)) / 100.0), self.height

<GoldCheckbox@Button>:
    # a checkbox that matches the rest of the palette
    active: False
    size_hint_x: None
    width: dp(26)
    background_normal: ''
    background_down: ''
    background_color: 0, 0, 0, 0
    canvas.after:
        Color:
            rgba: (0.941, 0.647, 0.0, 1) if self.active else (0.3, 0.3, 0.3, 1)
        Line:
            width: 1.2
            rectangle: self.center_x - dp(9), self.center_y - dp(9), dp(18), dp(18)
        Color:
            rgba: (0.941, 0.647, 0.0, 1) if self.active else (0, 0, 0, 0)
        Rectangle:
            pos: self.center_x - dp(5), self.center_y - dp(5)
            size: dp(10), dp(10)

<LogLine@Label>:
    size_hint_y: None
    height: dp(15)
    halign: 'left'
    valign: 'middle'
    shorten: True
    shorten_from: 'left'
    font_size: sp(11)
    font_name: 'desqueeze-mono'
    color: 0.53, 0.53, 0.53, 1
    text_size: self.width - dp(12), self.height


# --- the per-file progress table -------------------------------------------

<QueueRow>:
    orientation: 'vertical'
    size_hint_y: None
    height: dp(34)
    padding: [dp(8), dp(3), dp(8), dp(3)]
    spacing: dp(3)

    BoxLayout:
        size_hint_y: None
        height: dp(15)
        spacing: dp(6)
        Label:
            text: root.name
            halign: 'left'
            valign: 'middle'
            shorten: True
            shorten_from: 'left'
            font_size: sp(11)
            font_name: 'desqueeze-mono'
            color:
                (0.941, 0.647, 0.0, 1) if root.status == 'working' else \
                ((0.753, 0.251, 0.251, 1) if root.status == 'failed' else \
                ((0.4, 0.4, 0.4, 1) if root.status == 'skipped' else (0.78, 0.78, 0.78, 1)))
            text_size: self.width, self.height
        Label:
            text: root.detail
            size_hint_x: None
            width: dp(150)
            halign: 'right'
            valign: 'middle'
            shorten: True
            shorten_from: 'right'
            font_size: sp(10)
            font_name: 'desqueeze-mono'
            color:
                (0.753, 0.251, 0.251, 1) if root.status == 'failed' else (0.45, 0.45, 0.45, 1)
            text_size: self.width, self.height

    # per-file progress: gold while working, dim green-grey once done
    Widget:
        size_hint_y: None
        height: dp(4)
        canvas:
            Color:
                rgba: 0.1, 0.1, 0.1, 1
            Rectangle:
                pos: self.pos
                size: self.size
            Color:
                rgba:
                    (0.753, 0.251, 0.251, 1) if root.status == 'failed' else \
                    ((0.941, 0.647, 0.0, 1) if root.status == 'working' else \
                    ((0.35, 0.42, 0.3, 1) if root.status == 'done' else (0.16, 0.16, 0.16, 1)))
            Rectangle:
                pos: self.pos
                size: self.width * (max(0, min(100, root.percent)) / 100.0), self.height


# --- the screen -------------------------------------------------------------

<Root>:
    orientation: 'horizontal' if app.wide else 'vertical'
    # extra top/bottom padding keeps content clear of the system bars
    padding: [dp(16), dp(16) + app.inset_top, dp(16), dp(12) + app.inset_bottom]
    spacing: dp(12)
    canvas.before:
        Color:
            rgba: 0.078, 0.078, 0.078, 1
        Rectangle:
            pos: self.pos
            size: self.size

    # ---- controls column
    # Always scrollable, so a short screen (small phone, split-screen, landscape)
    # can never clip the controls no matter what the breakpoint decides.
    ScrollView:
        size_hint_x: 0.55 if app.wide else 1
        size_hint_y: None
        pos_hint: {'top': 1}
        # Take exactly the height the controls need, so RUN is never half cut
        # off, but never more than the screen minus a usable strip for the table.
        height:
            min(controls.minimum_height, root.height - root.padding[1] \
            - root.padding[3] - (0 if app.wide else dp(190)))
        do_scroll_x: False
        bar_width: dp(3)
        bar_color: 0.2, 0.2, 0.2, 1
        effect_cls: 'ScrollEffect'

        BoxLayout:
            id: controls
            orientation: 'vertical'
            spacing: dp(8)
            size_hint_y: None
            height: self.minimum_height

            Label:
                text: 'DESQUEEZE'
                size_hint_y: None
                height: dp(38)
                halign: 'left'
                valign: 'middle'
                bold: True
                font_size: sp(26)
                font_name: 'desqueeze-mono'
                color: 0.941, 0.647, 0.0, 1
                text_size: self.width, self.height

            Label:
                text: 'Anamorphic Desqueezer'
                size_hint_y: None
                height: dp(16)
                halign: 'left'
                valign: 'top'
                font_size: sp(11)
                font_name: 'desqueeze-mono'
                color: 0.4, 0.4, 0.4, 1
                text_size: self.width, self.height

            # ---- tabs
            BoxLayout:
                size_hint_y: None
                height: dp(42)
                spacing: dp(2)
                TabButton:
                    text: 'PHOTOS'
                    state: 'down' if app.media == 'photo' else 'normal'
                    disabled: app.is_running
                    on_release: app.select_media('photo')
                TabButton:
                    text: 'VIDEO'
                    state: 'down' if app.media == 'video' else 'normal'
                    disabled: app.is_running
                    on_release: app.select_media('video')

            SectionLabel:
                text: 'ENGINE'
            Field:
                PathLabel:
                    text: app.engine_status
                    shorten_from: 'right'
                    color: (0.941, 0.647, 0.0, 1) if app.engine_ready else (0.753, 0.251, 0.251, 1)

            SectionLabel:
                text:
                    'VIDEO FILES  (MP4 / MOV)' if app.media == 'video' \
                    else 'IMAGES  (RAW / TIFF / PNG / JPEG)'
            Field:
                spacing: dp(6)
                padding: [0, 0, 0, 0]
                PathLabel:
                    text: app.source_text
                    shorten_from: 'right'
                GhostButton:
                    text: 'Select'
                    disabled: app.is_running
                    on_release: app.browse_source()

            SectionLabel:
                text: 'OUTPUT FOLDER  (remembered)'
            Field:
                spacing: dp(6)
                PathLabel:
                    text: app.dest_text
                GhostButton:
                    text: 'Browse'
                    disabled: app.is_running
                    on_release: app.browse_dest()

            BoxLayout:
                size_hint_y: None
                height: dp(38)
                disabled: app.is_running
                spacing: dp(8)
                Label:
                    text: 'Subfolder:'
                    size_hint_x: None
                    width: dp(88)
                    halign: 'left'
                    valign: 'middle'
                    font_size: sp(11)
                    font_name: 'desqueeze-mono'
                    color: 0.53, 0.53, 0.53, 1
                    text_size: self.width, self.height
                NameInput:
                    id: dest_name
                    text: app.dest_folder_name
                    on_text: app.dest_folder_name = self.text

            SectionLabel:
                text: 'SQUEEZE RATIO  -  Lens Preset'
            DarkSpinner:
                id: preset
                size_hint_y: None
                height: dp(42)
                text: app.preset_label
                values: app.preset_labels
                disabled: app.is_running
                on_text: app.select_preset(self.text)

            BoxLayout:
                size_hint_y: None
                height: dp(38) if app.is_custom else 0
                opacity: 1 if app.is_custom else 0
                disabled: not app.is_custom or app.is_running
                spacing: dp(8)
                Label:
                    text: 'Squeeze X:'
                    size_hint_x: None
                    width: dp(84)
                    halign: 'left'
                    valign: 'middle'
                    font_size: sp(11)
                    font_name: 'desqueeze-mono'
                    color: 0.53, 0.53, 0.53, 1
                    text_size: self.width, self.height
                NumberInput:
                    size_hint_x: None
                    width: dp(78)
                    text: app.custom_x
                    on_text: app.custom_x = self.text
                Label:
                    text: 'Y:'
                    size_hint_x: None
                    width: dp(24)
                    halign: 'right'
                    valign: 'middle'
                    font_size: sp(11)
                    font_name: 'desqueeze-mono'
                    color: 0.53, 0.53, 0.53, 1
                    text_size: self.width, self.height
                NumberInput:
                    size_hint_x: None
                    width: dp(78)
                    text: app.custom_y
                    on_text: app.custom_y = self.text
                Widget:

            # ---- video-only encoder settings
            SectionLabel:
                text: 'OUTPUT METHOD' if app.media == 'video' else ''
                height: dp(16) if app.media == 'video' else 0
                opacity: 1 if app.media == 'video' else 0

            BoxLayout:
                size_hint_y: None
                height: dp(34) if app.media == 'video' else 0
                opacity: 1 if app.media == 'video' else 0
                disabled: app.media != 'video' or app.is_running or not app.transcode_available
                spacing: dp(4)
                GoldCheckbox:
                    active: app.transcode
                    on_release: app.transcode = not app.transcode
                Label:
                    text:
                        'Re-encode to HEVC (real pixels)' if app.transcode_available \
                        else 'Re-encode unavailable on this device'
                    halign: 'left'
                    valign: 'middle'
                    font_size: sp(11)
                    font_name: 'desqueeze-mono'
                    color: (0.78, 0.78, 0.78, 1) if app.transcode else (0.45, 0.45, 0.45, 1)
                    text_size: self.width, self.height

            Label:
                text:
                    'Off: writes the pasp atom - instant and lossless, read by editors.' \
                    if not app.transcode else \
                    'On: re-encodes the pixels - slower and lossy, plays anywhere.'
                size_hint_y: None
                height: dp(28) if app.media == 'video' else 0
                opacity: 1 if app.media == 'video' else 0
                halign: 'left'
                valign: 'top'
                font_size: sp(10)
                font_name: 'desqueeze-mono'
                color: 0.4, 0.4, 0.4, 1
                text_size: self.width, self.height

            BoxLayout:
                size_hint_y: None
                height: dp(38) if (app.media == 'video' and app.transcode) else 0
                opacity: 1 if (app.media == 'video' and app.transcode) else 0
                disabled: not (app.media == 'video' and app.transcode) or app.is_running
                spacing: dp(8)
                Label:
                    text: 'Bitrate:'
                    size_hint_x: None
                    width: dp(64)
                    halign: 'left'
                    valign: 'middle'
                    font_size: sp(11)
                    font_name: 'desqueeze-mono'
                    color: 0.53, 0.53, 0.53, 1
                    text_size: self.width, self.height
                NumberInput:
                    size_hint_x: None
                    width: dp(70)
                    text: app.bitrate_mbps
                    on_text: app.bitrate_mbps = self.text
                Label:
                    text: 'Mbps'
                    size_hint_x: None
                    width: dp(46)
                    halign: 'left'
                    valign: 'middle'
                    font_size: sp(10)
                    font_name: 'desqueeze-mono'
                    color: 0.4, 0.4, 0.4, 1
                    text_size: self.width, self.height
                DarkSpinner:
                    text: app.bitrate_mode
                    values: app.bitrate_modes
                    on_text: app.bitrate_mode = self.text

            Divider:

            BoxLayout:
                size_hint_y: None
                height: dp(48)
                spacing: dp(8)
                RunButton:
                    text: 'RUN DESQUEEZE'
                    disabled: app.is_running
                    on_release: app.start_run()
                CancelButton:
                    text: 'CANCEL'
                    size_hint_x: None
                    width: dp(110)
                    disabled: not app.is_running
                    on_release: app.cancel_run()

            GoldProgress:
                value: app.progress_value

    # ---- queue table + collapsible log
    BoxLayout:
        orientation: 'vertical'
        spacing: dp(4)
        size_hint_x: 0.45 if app.wide else 1
        size_hint_y: 1

        SectionLabel:
            text: 'QUEUE  (%d)' % len(app.queue_rows)

        RecycleView:
            id: queue_view
            viewclass: 'QueueRow'
            data: app.queue_rows
            scroll_type: ['bars', 'content']
            bar_width: dp(4)
            bar_color: 0.2, 0.2, 0.2, 1
            bar_inactive_color: 0.13, 0.13, 0.13, 1
            canvas.before:
                Color:
                    rgba: 0.051, 0.051, 0.051, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
                Color:
                    rgba: 0.133, 0.133, 0.133, 1
                Line:
                    width: 1
                    rectangle: self.x, self.y, self.width, self.height
            RecycleBoxLayout:
                orientation: 'vertical'
                padding: [0, dp(4)]
                default_size: None, dp(34)
                default_size_hint: 1, None
                size_hint_y: None
                height: self.minimum_height

        # ---- log: a one-line summary that expands on tap
        Button:
            size_hint_y: None
            height: dp(26)
            background_normal: ''
            background_down: ''
            background_color: 0.09, 0.09, 0.09, 1
            on_release: app.toggle_log()
            text: ('v  LOG' if app.log_open else '>  LOG') + '    ' + app.log_summary
            halign: 'left'
            valign: 'middle'
            shorten: True
            shorten_from: 'right'
            font_size: sp(10)
            font_name: 'desqueeze-mono'
            color: 0.45, 0.45, 0.45, 1
            text_size: self.width - dp(12), self.height

        RecycleView:
            id: log_view
            viewclass: 'LogLine'
            size_hint_y: None
            height: (root.height * 0.32) if app.log_open else 0
            opacity: 1 if app.log_open else 0
            scroll_type: ['bars', 'content']
            bar_width: dp(4)
            bar_color: 0.2, 0.2, 0.2, 1
            bar_inactive_color: 0.13, 0.13, 0.13, 1
            canvas.before:
                Color:
                    rgba: 0.051, 0.051, 0.051, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
                Color:
                    rgba: 0.133, 0.133, 0.133, 1
                Line:
                    width: 1
                    rectangle: self.x, self.y, self.width, self.height
            RecycleBoxLayout:
                orientation: 'vertical'
                padding: [dp(6), dp(6)]
                default_size: None, dp(15)
                default_size_hint: 1, None
                size_hint_y: None
                height: self.minimum_height
